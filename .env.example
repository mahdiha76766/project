# ─────────────────────────────────────────────
# عصاره طبیعت — Next.js Shop (Production / Dev)
# کپی کنید به: .env.local (توسعه) یا .env (سرور)
# ─────────────────────────────────────────────

# پورت اجرا — Next.js متغیر PORT را خودکار می‌خواند
PORT=2811
NODE_ENV=production

# MongoDB (نام دیتابیس از مسیر URI خوانده می‌شود، مثلاً /nedicon1_web)
MONGODB_URI=mongodb://username:password@localhost:27017/dbname

# احراز هویت (الزامی در production)
AUTH_SECRET=your-long-random-secret-min-32-chars

# آدرس عمومی سایت (برای ریدایرکت پرداخت و لینک‌ها)
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# درگاه پرداخت سامان (SEP)
SAMAN_TERMINAL_ID=
SAMAN_MERCHANT_ID=
SAMAN_TERMINAL_PASS=
SAMAN_CALLBACK_URL=https://your-domain.com/api/payment/verify

# تنظیمات مالی
PAYMENT_TAX_RATE=0
WALLET_MIN_WITHDRAWAL=10000
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# کرون انقضای پرداخت (اختیاری)
# CRON_SECRET=

# SMS.ir — کلیدها از پنل ادمین > پیامک SMS هم قابل تنظیم است
# SMS_IR_API_KEY=
# SMS_IR_SANDBOX_API_KEY=
