# Copy to .env and fill real values. Never commit secrets.

NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=

# Auth — required in production. Cookie session HMAC secret.
AUTH_SECRET=

# Public site URL for sitemap, canonical, OG
APP_BASE_URL=http://localhost:3000

# Persistent uploads directory (absolute). Required.
UPLOADS_DIR=

# Optional payment / SMS integrations
SAMAN_TERMINAL_ID=
SAMAN_MERCHANT_ID=
SAMAN_CALLBACK_URL=
PAYMENT_TAX_RATE=0
WALLET_MIN_WITHDRAWAL=10000
ORDER_PAYMENT_TIMEOUT_MINUTES=15
